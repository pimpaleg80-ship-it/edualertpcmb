// ============================================================================
// EduAlert PCMB - Complete PostgreSQL / Supabase Prisma Relational Schema
// Designed for tracking Indian Competitive Entrance Exams (PCM, PCB, PCMB)
// ============================================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum ExamCategory {
  ENGINEERING_PCM
  MEDICAL_PCB
  DEFENSE_PCM_PCMB
  RESEARCH_PCMB
  STATE_CET
}

enum AcademicStream {
  PCM
  PCB
  PCMB
}

enum EventType {
  INFORMATION_BULLETIN_OUT
  REGISTRATION_OPEN
  REGISTRATION_LATE_FEE
  CORRECTION_WINDOW
  CITY_INTIMATION_SLIP
  ADMIT_CARD_RELEASE
  EXAM_SESSION_1
  EXAM_SESSION_2
  PROVISIONAL_ANSWER_KEY
  ANSWER_KEY_CHALLENGE_END
  FINAL_RESULT
  COUNSELING_REGISTRATION
}

enum NotificationChannel {
  IN_APP_FCM
  WHATSAPP
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum PriorityLevel {
  NORMAL
  HIGH
  URGENT_DREAM_EXAM
}

// ----------------------------------------------------------------------------
// MODELS
// ----------------------------------------------------------------------------

/// Central catalog of competitive examinations
model Exam {
  id                  String       @id @default(uuid()) @db.Uuid
  slug                String       @unique @db.VarChar(100)
  fullName            String       @map("full_name") @db.VarChar(255)
  shortCode           String       @map("short_code") @db.VarChar(50)
  category            ExamCategory
  streamEligibility   AcademicStream[] @map("stream_eligibility")
  conductingBody      String       @map("conducting_body") @db.VarChar(150) // e.g., NTA, UPSC, IIT Madras, State CET Cell
  officialWebsite     String       @map("official_website") @db.VarChar(500)
  applicationUrl      String       @map("application_url") @db.VarChar(500)
  eligibilitySummary  String       @map("eligibility_summary") @db.Text
  minBoardPercentage  Float?       @map("min_board_percentage")
  ageLimitNotes       String?      @map("age_limit_notes") @db.VarChar(255)
  examMode            String       @default("CBT") @map("exam_mode") @db.VarChar(50) // CBT, OMR / Pen & Paper, Hybrid
  markingScheme       String       @default("+4, -1") @map("marking_scheme") @db.VarChar(100)
  syllabusUrl         String?      @map("syllabus_url") @db.VarChar(500)
  informationBulletinUrl String?   @map("information_bulletin_url") @db.VarChar(500)
  stateDomicileCode   String?      @map("state_domicile_code") @db.VarChar(10) // e.g. "MH", "KA", "WB" for State CETs
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  // Relations
  dates               ExamDate[]
  fees                ExamFee[]
  notificationQueues  NotificationQueue[]
  userApplications    UserApplicationTracker[]

  @@index([category])
  @@index([stateDomicileCode])
  @@map("exams")
}

/// Sequential event stages and deadline milestones per exam
model ExamDate {
  id             String    @id @default(uuid()) @db.Uuid
  examId         String    @map("exam_id") @db.Uuid
  eventType      EventType @map("event_type")
  title          String    @db.VarChar(200)
  startDatetime  DateTime  @map("start_datetime")
  endDatetime    DateTime? @map("end_datetime")
  isTentative    Boolean   @default(false) @map("is_tentative")
  isExtended     Boolean   @default(false) @map("is_extended")
  announcementRef String?  @map("announcement_ref") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId, eventType])
  @@index([startDatetime])
  @@index([endDatetime])
  @@map("exam_dates")
}

/// Category-wise application fee structure
model ExamFee {
  id            String   @id @default(uuid()) @db.Uuid
  examId        String   @map("exam_id") @db.Uuid
  categoryLabel String   @map("category_label") @db.VarChar(100) // General, OBC-NCL, EWS, SC, ST, Female, PwD
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR") @db.VarChar(10)
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@map("exam_fees")
}

/// Student personalization & onboarding profile
model UserPreference {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @unique @map("user_id") @db.VarChar(128) // Supabase Auth UID
  stream           AcademicStream  @default(PCM)
  homeState        String          @default("All-India") @map("home_state") @db.VarChar(100) // State of Domicile
  targetPathways   String[]        @map("target_pathways") // ["ENGINEERING", "RESEARCH", "DEFENSE"]
  followedExamIds  String[]        @map("followed_exam_ids") // Array of Exam UUIDs
  dreamExamIds     String[]        @map("dream_exam_ids") // Max 3 high-priority exams for DND bypass
  fcmToken         String?         @map("fcm_token") @db.VarChar(512)
  phoneNumber      String?         @map("phone_number") @db.VarChar(20)
  whatsappEnabled  Boolean         @default(false) @map("whatsapp_enabled")
  pushEnabled      Boolean         @default(true) @map("push_enabled")
  dndStartHour     Int             @default(22) @map("dnd_start_hour") // 10 PM
  dndEndHour       Int             @default(6) @map("dnd_end_hour")   // 6 AM
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  // Relations
  notificationLogs NotificationQueue[]
  applications     UserApplicationTracker[]

  @@map("user_preferences")
}

/// Queue and dispatch log for push, WhatsApp, and SMS alerts
model NotificationQueue {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.VarChar(128)
  examId       String              @map("exam_id") @db.Uuid
  channel      NotificationChannel @default(IN_APP_FCM)
  priority     PriorityLevel       @default(NORMAL)
  scheduledAt  DateTime            @map("scheduled_at")
  sentAt       DateTime?           @map("sent_at")
  status       NotificationStatus  @default(PENDING)
  title        String              @db.VarChar(255)
  body         String              @db.Text
  deepLinkUrl  String?             @map("deep_link_url") @db.VarChar(500)
  payloadJson  Json?               @map("payload_json")
  errorMessage String?             @map("error_message") @db.Text
  createdAt    DateTime            @default(now()) @map("created_at")

  // Relations
  userPref     UserPreference      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  exam         Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, status])
  @@index([userId])
  @@index([examId])
  @@map("notifications_queue")
}

/// Personal Application Tracker: Local & synced application stages and credentials
model UserApplicationTracker {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @map("user_id") @db.VarChar(128)
  examId               String         @map("exam_id") @db.Uuid
  isApplied            Boolean        @default(false) @map("is_applied")
  isFeePaid            Boolean        @default(false) @map("is_fee_paid")
  isAdmitCardDownloaded Boolean       @default(false) @map("is_admit_card_downloaded")
  applicationNumberEnc  String?       @map("application_number_enc") @db.Text // Stored encrypted on-device/backend
  loginIdEnc           String?        @map("login_id_enc") @db.Text
  personalNotes        String?        @map("personal_notes") @db.Text
  appliedDate          DateTime?      @map("applied_date")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  // Relations
  userPref             UserPreference @relation(fields: [userId], references: [userId], onDelete: Cascade)
  exam                 Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@map("user_application_trackers")
}
